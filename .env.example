# Docker: ajuste estes valores em cada copia do projeto para isolar containers e portas.
# COMPOSE_PROJECT_NAME="redacao-app-copia-1"
APP_PORT="3002"
POSTGRES_PORT="5434"

# Se mudar APP_PORT ou POSTGRES_PORT, ajuste tambem as URLs abaixo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/redacao_app?schema=public"
NEXTAUTH_SECRET="use-uma-chave-segura"
NEXTAUTH_URL="http://localhost:3002"
APP_URL="http://localhost:3002"
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-..."
SMTP_HOST="smtp.seuprovedor.com"
SMTP_PORT="587"
SMTP_USER="usuario"
SMTP_PASSWORD="senha"
SMTP_FROM="Redacao 360 <no-reply@redacao360.com>"
SMTP_SECURE="false"
