generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ActivityStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  RETURNED
  GRADED
}

enum StudentPlan {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum RegistrationStatus {
  DRAFT
  CHECKOUT_PENDING
  PAYMENT_PENDING
  APPROVED
  FAILED
  EXPIRED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String           @unique
  passwordHash   String?
  role           Role             @default(STUDENT)
  isActive       Boolean          @default(true)
  image          String?
  emailVerified  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  accounts       Account[]
  sessions       Session[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  passwordSetupTokens PasswordSetupToken[]
  registrationSessions RegistrationSession[]
}

model StudentProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  gradeLevel       String?
  cpf              String?
  enrollmentNumber String?
  plan             StudentPlan?
  readingClub      Boolean       @default(false)
  mentoring         Boolean       @default(false)
  bio              String?
  avatarUrl        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])
  submissions      Submission[]
}

model TeacherProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  expertise       String?
  bio             String?
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  activities      Activity[]
  corrections     Correction[]
  videoCategories VideoCategory[]
  videoClassrooms VideoClassroom[]
  videoModules    VideoModule[]
  videoLessons    VideoLesson[]
  liveClasses     LiveClass[]
}

model Activity {
  id           String               @id @default(cuid())
  title        String
  description  String
  prompt       String
  tags         String[]
  status       ActivityStatus       @default(DRAFT)
  publishedAt  DateTime?
  dueDate      DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  createdById  String?
  createdBy    TeacherProfile?      @relation(fields: [createdById], references: [id])
  attachments  ActivityAttachment[]
  submissions  Submission[]
}

model ActivityAttachment {
  id          String   @id @default(cuid())
  activityId  String
  fileName    String
  mimeType    String
  sizeInBytes Int
  fileData    Bytes
  createdAt   DateTime @default(now())
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
}

model Submission {
  id           String            @id @default(cuid())
  studentId    String
  activityId   String
  content      String
  pdfUrl       String?
  pdfName      String?
  pdfMimeType  String?
  pdfData      Bytes?
  status       SubmissionStatus  @default(PENDING)
  submittedAt  DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  grade        Int?
  feedback     String?
  student      StudentProfile    @relation(fields: [studentId], references: [id])
  activity     Activity          @relation(fields: [activityId], references: [id])
  corrections  Correction[]
}

model Correction {
  id           String          @id @default(cuid())
  submissionId String
  teacherId    String
  comments     String?
  score        Int
  strengths    String[]
  improvements String[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  submission   Submission      @relation(fields: [submissionId], references: [id])
  teacher      TeacherProfile  @relation(fields: [teacherId], references: [id])
}

model VideoCategory {
  id          String         @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdById String?
  createdBy   TeacherProfile? @relation(fields: [createdById], references: [id])
  lessons     VideoLesson[]
}

model VideoClassroom {
  id          String          @id @default(cuid())
  name        String
  description String?
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById String?
  createdBy   TeacherProfile? @relation(fields: [createdById], references: [id])
  modules     VideoModule[]
  lessons     VideoLesson[]
}

model VideoModule {
  id          String          @id @default(cuid())
  title       String
  description String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  classroomId String
  classroom   VideoClassroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   TeacherProfile? @relation(fields: [createdById], references: [id])
  lessons     VideoLesson[]

  @@index([classroomId, sortOrder])
}

model VideoLesson {
  id           String         @id @default(cuid())
  title        String
  description  String
  videoUrl     String
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?
  createdBy    TeacherProfile? @relation(fields: [createdById], references: [id])
  categoryId   String?
  category     VideoCategory? @relation(fields: [categoryId], references: [id])
  classroomId  String?
  classroom    VideoClassroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  moduleId     String?
  module       VideoModule?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([classroomId, moduleId, sortOrder])
}

model LiveClass {
  id           String         @id @default(cuid())
  title        String
  description  String
  scheduledAt  DateTime
  meetingUrl   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?
  createdBy    TeacherProfile? @relation(fields: [createdById], references: [id])
}

/// NextAuth standard models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PlatformSettings {
  id                         String   @id
  bankRecipientName          String?
  bankDocument               String?
  bankName                   String?
  bankAgency                 String?
  bankAccount                String?
  pixKey                     String?
  whatsappNumber             String?
  paymentNotes               String?
  mensalPlanPriceInCents     Int      @default(8000)
  trimestralPlanPriceInCents Int      @default(21800)
  semestralPlanPriceInCents  Int      @default(41300)
  anualPlanPriceInCents      Int      @default(76800)
  mentoriaPlanPriceInCents   Int      @default(12000)
  readingClubPriceInCents    Int      @default(3000)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model RegistrationSession {
  id                     String             @id @default(cuid())
  publicToken            String             @unique
  name                   String
  email                  String
  passwordHash           String
  role                   Role
  gradeLevel             String?
  expertise              String?
  plan                   StudentPlan?
  readingClub            Boolean            @default(false)
  mentoring              Boolean            @default(false)
  acceptedPrivacyPolicy  Boolean            @default(false)
  acceptedTerms          Boolean            @default(false)
  selectedPaymentMethod  PaymentMethod?
  amountInCents          Int
  status                 RegistrationStatus @default(DRAFT)
  provider               String?
  providerPreferenceId   String?
  providerPaymentId      String?
  checkoutUrl            String?
  expiresAt              DateTime
  completedAt            DateTime?
  createdUserId          String?
  createdUser            User?              @relation(fields: [createdUserId], references: [id])
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([email, status])
  @@index([providerPaymentId])
}

model PasswordSetupToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
