{
  "name": "redacao-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "publish": "node scripts/sync-git.mjs",
    "sync": "node scripts/sync-git.mjs",
    "autosync": "node scripts/auto-sync.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:rls": "prisma db execute --schema prisma/schema.prisma --file prisma/rls.sql",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "prisma db seed",
    "docker:dev": "docker compose up --build app",
    "docker:up": "docker compose up -d --build app",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.5",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "prisma": "^5.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
